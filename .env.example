# Copy this file to .env and adjust the values before running ./deploy.sh.

# --- App image ---------------------------------------------------------------
APP_IMAGE=sealroute/sealroute:latest
APP_PULL_POLICY=always

# --- Web ---------------------------------------------------------------------
# Public URL of your SealRoute instance. Use https://your.domain in production.
APP_URL=https://your.domain
# Caddy binds to this host and issues a TLS cert for it automatically.
HOST=your.domain
# FORCE_SSL=true             # leave empty for local http

# --- Rails -------------------------------------------------------------------
# Generate with: openssl rand -hex 64 (./deploy.sh will auto-generate if left as
# the placeholder below).
SECRET_KEY_BASE=replace-me-with-a-long-random-string
RAILS_LOG_LEVEL=info

# --- Aplindo licensing -------------------------------------------------------
APLINDO_LICENSE_API_URL=https://license.aplindo.tech
APLINDO_LICENSE_PRODUCT_SLUG=SealRoute
APLINDO_LICENSE_DEFAULT_AMOUNT_IDR=5000000.00
APLINDO_LICENSE_HEARTBEAT_SECONDS=3600
# APLINDO_CHECKOUT_MAX_AMOUNT_IDR=5000000.00

# --- Marketing-page price conversions (optional) -----------------------------
# Indicative USD->IDR rate used only to display competitor pricing in the
# /pricing and / pages. Defaults to 16000 if unset.
# LICENSE_PRICE_USD_TO_IDR_RATE=16000
# Year-2+ renewal as a fraction of the perpetual license price.
# LICENSE_RENEWAL_RATIO=0.5
