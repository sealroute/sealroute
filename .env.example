# Copy this file to .env and adjust the values before running ./deploy.sh.

# --- App image ---------------------------------------------------------------
APP_IMAGE=sealroute/sealroute:latest
APP_PULL_POLICY=always

# --- Web ---------------------------------------------------------------------
# Public URL of your SealRoute instance. Use https://your.domain in production.
APP_URL=https://your.domain
# Caddy binds to this host and issues a TLS cert for it automatically.
HOST=your.domain
# FORCE_SSL=true             # leave empty for local http

# --- Rails -------------------------------------------------------------------
# Generate with: openssl rand -hex 64 (./deploy.sh will auto-generate if left as
# the placeholder below).
SECRET_KEY_BASE=replace-me-with-a-long-random-string
RAILS_LOG_LEVEL=info
