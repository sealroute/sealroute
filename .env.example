# Copy this file to .env and run ./deploy.sh up.
#
# The defaults below run a fully working local instance on
# http://localhost:3000 with no edits required. To serve a public domain with
# automatic HTTPS, see the "Production (domain + HTTPS)" block at the bottom.

# --- App image ---------------------------------------------------------------
APP_IMAGE=sealroute/sealroute:latest
APP_PULL_POLICY=always

# --- Web ---------------------------------------------------------------------
# Host port the app is published on -> http://localhost:${APP_PORT}.
APP_PORT=3000
# Public URL of your instance. Used in outbound email links.
APP_URL=http://localhost:3000
HOST=localhost

# --- Rails -------------------------------------------------------------------
# Generate with: openssl rand -hex 64 (./deploy.sh auto-generates this on first
# run if left as the placeholder below).
SECRET_KEY_BASE=replace-me-with-a-long-random-string
RAILS_LOG_LEVEL=info

# --- Demo mode ---------------------------------------------------------------
# Set DEMO=true to run a public demo instance (auto signs in a random user).
# DEMO=true
#
# When DEMO_RESET=true the instance periodically wipes visitor-created data
# (templates, submissions and the documents they uploaded/generated) while
# preserving any record or uploaded file whose name/filename starts with
# DEMO_RESET_PREFIX. Cleanup runs every DEMO_RESET_INTERVAL_SECONDS.
# DEMO_RESET=true
# DEMO_RESET_INTERVAL_SECONDS=3600
# DEMO_RESET_PREFIX=DEMO_
#
# Multi-user demo: set DEMO_AUTO_LOGIN=false to stop the forced auto-login so
# visitors log in manually (and can log out). When auto-login is on, pin which
# user is signed in with DEMO_AUTO_LOGIN_EMAIL (defaults to a random user).
# DEMO_AUTO_LOGIN=false
# DEMO_AUTO_LOGIN_EMAIL=demo@demo.com
#
# Note shown under the login form (use \n for line breaks), e.g. test creds.
# DEMO_LOGIN_NOTE=user1@demo.com / password123\nuser2@demo.com / password123

# --- Marketing YouTube videos ------------------------------------------------
# Bare 11-char ID or full watch/share/embed URL. Leave blank to hide the block.
# MARKETING_YT_COMMERCIAL_EN=
# MARKETING_YT_COMMERCIAL_ID=
# MARKETING_YT_VIDA_JOURNEY_EN=
# MARKETING_YT_VIDA_JOURNEY_ID=
# MARKETING_YT_ENTERPRISE_RBAC_EN=
# MARKETING_YT_ENTERPRISE_RBAC_ID=
# MARKETING_YT_USECASE_DEVELOPERS_EN=
# MARKETING_YT_USECASE_DEVELOPERS_ID=
# MARKETING_YT_USECASE_HR_EN=
# MARKETING_YT_USECASE_HR_ID=
# MARKETING_YT_USECASE_PROCUREMENT_EN=
# MARKETING_YT_USECASE_PROCUREMENT_ID=
# MARKETING_YT_USECASE_FINANCE_EN=
# MARKETING_YT_USECASE_FINANCE_ID=
# MARKETING_YT_USECASE_LEGAL_EN=
# MARKETING_YT_USECASE_LEGAL_ID=
# MARKETING_YT_USECASE_SALES_EN=
# MARKETING_YT_USECASE_SALES_ID=
# MARKETING_YT_USECASE_OPERATIONS_EN=
# MARKETING_YT_USECASE_OPERATIONS_ID=
# MARKETING_YT_USECASE_COOPERATIVES_EN=
# MARKETING_YT_USECASE_COOPERATIVES_ID=

# --- Production (domain + HTTPS) ---------------------------------------------
# To serve a public domain with automatic TLS, point a DNS A record at this
# server, then set the four values below (replace the matching lines above) and
# re-run ./deploy.sh up. Caddy will bind :80/:443 and issue a Let's Encrypt
# certificate for HOST automatically.
#
#   HOST=your.domain
#   APP_URL=https://your.domain
#   FORCE_SSL=true
#   COMPOSE_PROFILES=tls
